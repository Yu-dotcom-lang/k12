        SELECT * FROM assessment_ai_practice_attempt
        WHERE student_user_id = #{studentUserId}
        ORDER BY created_time DESC, id DESC
        LIMIT #{limit}
    </select>
    <select id="canViewerAccessStudent" resultType="int">
        SELECT CASE WHEN
            EXISTS (
                SELECT 1 FROM assessment_homework_recipient r
                JOIN assessment_homework h ON h.id = r.homework_id
                WHERE r.student_user_id = #{studentUserId}
                  AND h.teacher_user_id = #{viewerUserId}
            ) OR EXISTS (
                SELECT 1 FROM learning_course_enrollment e
                JOIN learning_course c ON c.id = e.course_id
                WHERE e.user_id = #{studentUserId}
                  AND c.teacher_id = #{viewerUserId}
                  AND e.status = 'ACTIVE'
            ) THEN 1 ELSE 0 END
    </select>
</mapper>
